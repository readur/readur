{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'docker:enableMajor',
    'helpers:pinGitHubActionDigestsToSemver',
    'abandonments:recommended',
    // home-operations/renovate-config was renamed to renovate-presets and its
    // per-topic presets folded into one default.json that ships managers only;
    // grouping, labels and commit policy now live in packageRules below. Pinned
    // so an upstream restructure can't halt Renovate again (#986).
    'github>home-operations/renovate-presets#10.0.1',
    ':automergePr',
    ':configMigration',
    ':dependencyDashboard',
    ':disableRateLimiting',
  ],
  dependencyDashboardTitle: 'Renovate Dashboard 🤖',
  minimumReleaseAgeBehaviour: 'timestamp-optional',
  // Rebase only on conflict. The default (auto) rebases every automerge PR whenever
  // main moves, which reruns the full CI suite on all of them at once.
  rebaseWhen: 'conflicted',
  labels: ['dependencies', 'renovate'],
  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 3am on the first day of the month'],
    commitMessageExtra: '({{manager}})',
    additionalBranchPrefix: '{{manager}}-',
  },
  packageRules: [
    {
      description: "Keep every dependency PR a non-releasing chore without the breaking `!` the preset adds to majors, so release-please doesn't cut a release per bump",
      matchUpdateTypes: ['major', 'minor', 'patch', 'digest', 'lockFileMaintenance'],
      semanticCommitType: 'chore',
      commitMessagePrefix: '{{semanticCommitType}}({{semanticCommitScope}}):',
    },
    {
      description: 'Keep 0.x minors on their existing branches; the preset renames them to major- branches',
      matchUpdateTypes: ['minor'],
      matchCurrentVersion: '/^v?0\\./',
      additionalBranchPrefix: '',
    },
    {
      description: 'Label PRs by update type',
      matchUpdateTypes: [
        'major',
        'minor',
        'patch',
        'digest',
        'pin',
        'pinDigest',
        'lockFileMaintenance',
      ],
      addLabels: ['type/{{updateType}}'],
    },
    {
      description: 'Rust crates: chore(rust): update crate <name>',
      matchDatasources: ['crate'],
      semanticCommitScope: 'rust',
      commitMessageTopic: 'crate {{depName}}',
    },
    {
      description: 'npm packages: chore(npm): update dependency <name>',
      matchDatasources: ['npm'],
      semanticCommitScope: 'npm',
    },
    {
      description: 'One PR for all GitHub Actions workflow updates (majors still split out)',
      matchManagers: ['github-actions'],
      groupName: 'github-actions',
      groupSlug: 'github-actions',
    },
    {
      description: 'Batch mise dev tools; the rust and node runtimes stay separate PRs',
      matchManagers: ['mise'],
      matchUpdateTypes: ['minor', 'patch'],
      matchDepNames: ['!rust', '!node'],
      groupName: 'mise tools',
      groupSlug: 'mise-tools',
    },
    {
      description: 'NPM Bump Range Strategy',
      matchManagers: ['npm'],
      rangeStrategy: 'bump',
    },
    {
      description: 'Auto-merge non-major updates once every CI check passes, after a 3-day release cooldown',
      matchUpdateTypes: ['minor', 'patch', 'digest', 'lockFileMaintenance'],
      automerge: true,
      minimumReleaseAge: '3 days',
    },
    {
      description: 'zer0ver: Renovate counts a 0.x minor bump as major; auto-merge it like any other update once every CI check passes',
      matchUpdateTypes: ['major'],
      matchCurrentVersion: '/^v?0\\./',
      automerge: true,
      minimumReleaseAge: '3 days',
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      description: 'Bump the pinned ocrmypdf pip install in GitHub workflows',
      managerFilePatterns: ['/^\\.github/workflows/.*\\.ya?ml$/'],
      matchStrings: ['ocrmypdf==(?<currentValue>[0-9][0-9.]*)'],
      depNameTemplate: 'ocrmypdf',
      datasourceTemplate: 'pypi',
    },
  ],
}
