{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigestsToSemver",
    "abandonments:recommended",
    "github>home-operations/renovate-config:annotated.json5",
    "github>home-operations/renovate-config:groups.json5",
    "github>home-operations/renovate-config:labels.json5",
    "github>home-operations/renovate-config:semanticCommits.json5",
    ":automergePr",
    ":configMigration",
    ":dependencyDashboard",
    ":disableRateLimiting",
  ],
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  minimumReleaseAgeBehaviour: "timestamp-optional",
  // Rebase only on conflict. The default (auto) rebases every automerge PR whenever
  // main moves, which reruns the full CI suite on all of them at once.
  rebaseWhen: "conflicted",
  labels: ["dependencies", "renovate"],
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 3am on the first day of the month"],
    commitMessageExtra: "({{manager}})",
    additionalBranchPrefix: "{{manager}}-",
  },
  packageRules: [
    {
      description: "NPM Bump Range Strategy",
      matchManagers: ["npm"],
      rangeStrategy: "bump",
    },
    {
      description: "Auto-merge non-major updates once every CI check passes, after a 3-day release cooldown",
      matchUpdateTypes: ["minor", "patch", "digest", "lockFileMaintenance"],
      automerge: true,
      minimumReleaseAge: "3 days",
    },
    // Keep below the automerge rule so this one wins for 0.x minors.
    {
      description: "zer0ver: 0.x minors can break at any time; treat them like majors",
      matchUpdateTypes: ["minor"],
      matchCurrentVersion: "/^v?0\\./",
      automerge: false,
      dependencyDashboardApproval: true,
    },
    {
      description: "Majors wait for approval on the dashboard instead of sitting open and re-running CI on every rebase",
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
  ],
  customManagers: [
    {
      customType: "regex",
      description: "Bump the pinned ocrmypdf pip install in GitHub workflows",
      managerFilePatterns: ["/^\\.github/workflows/.*\\.ya?ml$/"],
      matchStrings: ["ocrmypdf==(?<currentValue>[0-9][0-9.]*)"],
      depNameTemplate: "ocrmypdf",
      datasourceTemplate: "pypi",
    },
  ],
}
